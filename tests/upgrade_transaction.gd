extends Node
var db: SQLite
var persistence: WorldDatabase
var character_id: int
var recipe: UpgradeDefinition = UpgradeDefinitions.BASIC
func seed_item(definition: ItemDefinition, amount: int = 1) -> String:
	var item: ItemInstance = ItemInstance.create(definition,character_id,[])
	item.amount = amount
	assert(db.query("BEGIN IMMEDIATE;"))
	assert(persistence.item_store.receive_item_in_transaction(item).ok)
	assert(db.query("COMMIT;"))
	return item.uid
func state() -> Dictionary:
	assert(db.query_with_bindings("SELECT yang FROM account_wallets WHERE account_id=(SELECT a.master_account_id FROM accounts a JOIN players p ON p.account_name=a.account_name WHERE p.player_id=?);",[character_id]))
	var balance: int = int(db.query_result[0].yang)
	return {"items":persistence.item_store.inventory(character_id),"db_yang":balance,"ram":persistence.runtime_wallets[persistence.wallet_account_id(character_id)].duplicate(true),"dirty":persistence.dirty_wallet.has(persistence.wallet_account_id(character_id))}
func _ready() -> void:
	assert(recipe.validation_errors().is_empty())
	var bad: UpgradeDefinition = recipe.duplicate(true)
	bad.to_level = 2
	assert("unsupported_upgrade" in bad.validation_errors())
	db = SQLite.new()
	db.path = "res://.godot/verification/upgrade-%s.db" % Crypto.new().generate_random_bytes(8).hex_encode()
	assert(db.open_db())
	WorldSchema.ensure_schema(db)
	persistence = WorldDatabase.new()
	persistence.db = db
	persistence.store = WorldStoreSqlite.new(db)
	persistence.item_store = ItemStoreSqlite.new(db)
	persistence.wallet_store = WalletStoreSqlite.new(db)
	character_id = EconomyFixture.create_character(persistence.store,"upgrade_fixture",{"name":"Smith tester","skin":1})
	assert(db.query_with_bindings("UPDATE account_wallets SET yang=0 WHERE account_id=(SELECT a.master_account_id FROM accounts a JOIN players p ON p.account_name=a.account_name WHERE p.player_id=?);", [character_id])) # Explicit economy fixture, independent of starter grant.
	EconomyFixture.prepare(persistence)
	assert(persistence.load_wallet(character_id))
	var sword: String = seed_item(ItemDefinitions.IRON_SWORD)
	assert(persistence.upgrade_candidate(character_id, sword, 0, null).error == "invalid_definition")
	assert(persistence.upgrade_operation(character_id, null, sword, 0, "upgrade-test-1").response().error == "invalid_definition")
	assert(persistence.upgrade_operation(character_id,recipe,sword,0).response().error == "request", "Upgrade requires an explicit stable operation ID")
	assert(persistence.add_yang(character_id,2100))
	var before: Dictionary = state()
	assert(persistence.upgrade_item(character_id,recipe,sword,0, "upgrade-test-2").error == "material")
	assert(state() == before, "Missing material cannot commit pending Yang")
	var ore: String = seed_item(ItemDefinitions.UPGRADE_ORE,2)
	before = state()
	assert(persistence.upgrade_item(character_id,recipe,sword,1, "upgrade-test-3").error == "stale")
	assert(persistence.upgrade_item(character_id,recipe,ore,0, "upgrade-test-4").error == "unsupported_item")
	assert(state() == before)
	assert(db.query("CREATE TEMP TRIGGER fail_upgrade BEFORE UPDATE ON item_instances WHEN NEW.definition_id='iron_sword' BEGIN SELECT RAISE(ABORT,'upgrade fault'); END;"))
	var failed_operation := persistence.upgrade_operation(character_id, recipe, sword, 0, "upgrade-test-5")
	assert(failed_operation.response().error == "storage" and not failed_operation.new_commit and not failed_operation.receipt_replay and failed_operation.changed_accounts.is_empty())
	assert(state() == before, "Late sword write failure rolls back consumed material, pending Yang and spend, including RAM dirty state")
	assert(db.query("DROP TRIGGER fail_upgrade;"))
	assert(db.query("CREATE TEMP TRIGGER fail_wallet BEFORE UPDATE ON account_wallets BEGIN SELECT RAISE(ABORT,'wallet fault'); END;"))
	assert(persistence.upgrade_item(character_id,recipe,sword,0, "upgrade-test-6").error == "storage")
	assert(state() == before, "Wallet failure restores material")
	assert(db.query("DROP TRIGGER fail_wallet;"))
	assert(db.query("CREATE TEMP TRIGGER fail_upgrade_receipt BEFORE INSERT ON market_commands WHEN NEW.kind='upgrade' BEGIN SELECT RAISE(ABORT,'receipt fault'); END;"))
	assert(persistence.upgrade_operation(character_id,recipe,sword,0,"receipt-retry").response().error == "storage")
	assert(state() == before, "Receipt failure rolls back material, Yang, item revision and RAM")
	assert(db.query("DROP TRIGGER fail_upgrade_receipt;"))
	var operation := persistence.upgrade_operation(character_id, recipe, sword, 0, "receipt-retry")
	var result := operation.response()
	assert(operation.action == "upgrade" and operation.character_id == character_id and operation.account_id == persistence.wallet_account_id(character_id))
	assert(operation.new_commit and not operation.receipt_replay and operation.changed_accounts == PackedInt64Array([operation.account_id]))
	assert(not operation.operation_id.is_empty(), "Upgrade retains business identity independent of RPC correlation")
	assert(result.ok and result.balance == 1100)
	var after: Dictionary = state()
	assert(after.db_yang == 1100 and after.ram.wallet_balance == 1100 and after.ram.pending_currency_delta == 0 and not after.dirty)
	var upgraded: Dictionary
	for item: Dictionary in after.items.items:
		if item.uid == sword:
			upgraded = item
			assert(item.upgrade_level == 1 and item.revision == 1 and item.bag_position == 0 and item.location == "bag" and item.stats.attack == 12)
		elif item.uid == ore: assert(item.amount == 1 and item.revision == 1)
	assert(not upgraded.is_empty())
	var replay := persistence.upgrade_operation(character_id,recipe,sword,0,operation.operation_id)
	assert(replay.response() == result and replay.receipt_replay and not replay.new_commit and replay.changed_accounts.is_empty(), "Same intention returns durable success after its revision changed")
	assert(persistence.upgrade_operation(character_id,recipe,sword,1,operation.operation_id).response().error == "command_conflict", "Changed expected revision cannot reuse an intention")
	var alternate: int = EconomyFixture.create_character(persistence.store,"upgrade_fixture",{"name":"Alternate","skin":1})
	assert(persistence.upgrade_operation(alternate,recipe,sword,0,operation.operation_id).response().error == "command_conflict", "Same-account alternate character cannot replay the upgrade")
	var stale_operation := persistence.upgrade_operation(character_id, recipe, sword, 0, "upgrade-test-8")
	assert(stale_operation.response().error == "stale" and not stale_operation.new_commit and not stale_operation.receipt_replay and stale_operation.changed_accounts.is_empty())
	assert(persistence.upgrade_item(character_id,recipe,sword,1, "upgrade-test-9").error == "upgrade_level")
	assert(state() == after, "Replay never consumes twice")
	var next_sword: String = seed_item(ItemDefinitions.IRON_SWORD)
	assert(persistence.item_store.change_equipment(character_id,next_sword,0,"equip").ok)
	before = state()
	assert(persistence.upgrade_item(character_id,recipe,next_sword,1, "upgrade-test-10").error == "placement")
	assert(state() == before)
	assert(persistence.item_store.change_equipment(character_id,next_sword,1,"unequip").ok)
	# Whole-stack deletion also rolls back if the later item write fails.
	before = state()
	assert(db.query("CREATE TEMP TRIGGER fail_upgrade BEFORE UPDATE ON item_instances WHEN NEW.definition_id='iron_sword' BEGIN SELECT RAISE(ABORT,'upgrade fault'); END;"))
	assert(persistence.upgrade_item(character_id,recipe,next_sword,2, "upgrade-test-11").error == "storage")
	assert(state() == before)
	assert(db.query("DROP TRIGGER fail_upgrade;"))
	assert(persistence.upgrade_item(character_id,recipe,next_sword,2, "upgrade-test-12").ok)
	assert(db.query_with_bindings("SELECT uid FROM item_instances WHERE uid=?;",[ore]) and db.query_result.is_empty())
	assert(db.query_with_bindings("SELECT item_uid FROM item_placements WHERE item_uid=?;",[ore]) and db.query_result.is_empty())
	var poor_sword: String = seed_item(ItemDefinitions.IRON_SWORD)
	seed_item(ItemDefinitions.UPGRADE_ORE)
	before = state()
	assert(persistence.upgrade_item(character_id,recipe,poor_sword,0, "upgrade-test-13").error == "funds")
	assert(state() == before)
	var other: int = EconomyFixture.create_character(persistence.store,"other",{"name":"Other","skin":1})
	assert(persistence.load_wallet(other) and persistence.add_yang(other,1000))
	assert(persistence.upgrade_item(other,recipe,poor_sword,0,operation.operation_id).error == "owner")
	assert(state() == before)
	assert(persistence.add_yang(character_id,17))
	before = state()
	assert(before.ram.wallet_balance < recipe.yang_cost)
	replay = persistence.upgrade_operation(character_id,recipe,sword,0,operation.operation_id)
	assert(replay.response() == result and replay.receipt_replay and state() == before, "Replay bypasses current affordability without overwriting newer pending income")
	assert(db.close_db() and db.open_db())
	assert(state() == before,"Final item/material/wallet state survives database reopen")
	replay = persistence.upgrade_operation(character_id,recipe,sword,0,operation.operation_id)
	assert(replay.response() == result and replay.receipt_replay and state() == before, "Receipt survives database reopen")
	assert(db.query("SELECT COUNT(*) AS n FROM market_commands WHERE kind='upgrade';") and int(db.query_result[0].n) == 2, "Only two successful upgrades create receipts; rejects/failed writes do not grow the table")
	db.close_db()
	persistence.free()
	print("UPGRADE_TRANSACTION_OK: UID/revision/ownership/Inventory, stack consumption, pending Yang, rollback, replay and durability")
	get_tree().quit()
