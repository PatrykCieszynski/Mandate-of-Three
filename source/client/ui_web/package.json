{
  "name": "mandate-cef-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-window-template.mjs",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.tests.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "precheck": "npm run generate",
    "prebuild:tests": "npm run build",
    "format": "prettier --write \"ts/core/**/*.ts\" \"ts/inventory/game.ts\" \"ts/inventory/domain-updates.ts\" \"ts/screens/**/*.ts\" \"test/core_cleanup.test.mts\" \"test/storage.fixture.mts\" \"dev/**/*.{ts,html,css}\" \"scripts/dev.mjs\" \"scripts/preview-server.mjs\" \"test/ui_preview_browser.mts\" \"scripts/preview-server.d.mts\"",
    "format:check": "prettier --check \"ts/core/**/*.ts\" \"ts/inventory/game.ts\" \"ts/inventory/domain-updates.ts\" \"ts/screens/**/*.ts\" \"test/core_cleanup.test.mts\" \"test/storage.fixture.mts\" \"dev/**/*.{ts,html,css}\" \"scripts/dev.mjs\" \"scripts/preview-server.mjs\" \"test/ui_preview_browser.mts\" \"scripts/preview-server.d.mts\"",
    "dev": "node scripts/dev.mjs",
    "build:dev": "tsc -p tsconfig.dev.json"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.1",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
