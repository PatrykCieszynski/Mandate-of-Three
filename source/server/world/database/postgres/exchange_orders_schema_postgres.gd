extends RefCounted
const LedgerSchema = preload("res://source/server/world/database/postgres/exchange_ledger_schema_postgres.gd")

static func ensure_schema(db: Object) -> bool:
	if not LedgerSchema.ensure_schema(db) or not db.begin(): return false
	var result: Dictionary=db.query("SELECT version FROM economy.schema_versions WHERE feature='exchange_orders';")
	if not result.ok or (not result.rows.is_empty() and int(result.rows[0].version)!=1):
		db.rollback()
		return false
	if result.rows.is_empty():
		for sql: String in [
			"CREATE TABLE economy.exchange_books(base_asset TEXT PRIMARY KEY);",
			"CREATE TABLE economy.exchange_orders(sequence BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,order_id TEXT UNIQUE NOT NULL CHECK(order_id ~ '^[0-9a-f]{32}$'),account_id BIGINT NOT NULL REFERENCES economy.accounts(account_id),base_asset TEXT NOT NULL REFERENCES economy.exchange_books(base_asset),quote_asset TEXT NOT NULL CHECK(quote_asset='yang'),side TEXT NOT NULL CHECK(side IN ('buy','sell')),quantity BIGINT NOT NULL CHECK(quantity BETWEEN 1 AND 9000000000000000),remaining BIGINT NOT NULL CHECK(remaining BETWEEN 0 AND quantity),price_num BIGINT NOT NULL CHECK(price_num BETWEEN 1 AND 1000000000),price_den BIGINT NOT NULL CHECK(price_den BETWEEN 1 AND 1000000000),reserved_amount BIGINT NOT NULL CHECK(reserved_amount BETWEEN 0 AND 9000000000000000),received BIGINT NOT NULL DEFAULT 0 CHECK(received BETWEEN 0 AND 9000000000000000),revision BIGINT NOT NULL DEFAULT 0 CHECK(revision>=0),status TEXT NOT NULL CHECK(status IN ('active','filled','cancelled')),CHECK(quantity%price_den=0 AND remaining%price_den=0),CHECK((side='sell' AND reserved_amount=remaining) OR (side='buy' AND reserved_amount=(remaining::numeric/price_den)*price_num)),CHECK((status='active' AND remaining>0) OR (status<>'active' AND remaining=0)));",
			"CREATE INDEX exchange_pair ON economy.exchange_orders(base_asset,quote_asset,status,side,sequence);",
			"CREATE INDEX exchange_account ON economy.exchange_orders(account_id,status,sequence);",
			"CREATE TABLE economy.exchange_fills(fill_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,maker_id TEXT NOT NULL REFERENCES economy.exchange_orders(order_id),taker_id TEXT NOT NULL REFERENCES economy.exchange_orders(order_id),base_quantity BIGINT NOT NULL CHECK(base_quantity>0),yang_amount BIGINT NOT NULL CHECK(yang_amount BETWEEN 1 AND 9000000000000000));",
			"INSERT INTO economy.schema_versions(feature,version) VALUES('exchange_orders',1);"
		]:
			if not db.execute(sql).ok:
				db.rollback()
				return false
	if db.commit(): return true
	db.close()
	return false
