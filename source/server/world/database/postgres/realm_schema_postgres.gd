extends RefCounted
## Offline provisioning of the remaining non-economy state. Never called at login.
static func ensure_schema(db: Object) -> bool:
	if not preload("res://source/server/world/database/postgres/economy_schema_postgres.gd").ensure_schema(db) or not db.begin(): return false
	var version: Dictionary=db.query("SELECT version FROM economy.schema_versions WHERE feature='realm_state';")
	if not version.ok or (not version.rows.is_empty() and int(version.rows[0].version)!=1):
		db.rollback();return false
	if not version.rows.is_empty():
		return db.commit() and preload("res://source/server/world/database/character_stats_schema.gd").postgres(db)
	var columns: Array[String]=[
		"player_id BIGINT PRIMARY KEY DEFAULT nextval('realm.player_ids')",
		"account_name TEXT NOT NULL REFERENCES realm.accounts(account_name)",
		"display_name TEXT NOT NULL", "skin_id BIGINT NOT NULL", "level BIGINT NOT NULL CHECK(level>=1)",
		"experience BIGINT NOT NULL CHECK(experience>=0)", "available_attributes_points BIGINT NOT NULL CHECK(available_attributes_points>=0)",
		"profile_status TEXT NOT NULL", "profile_animation TEXT NOT NULL", "active_guild_id BIGINT", "led_guild_id BIGINT"
	]
	for field: String in ["attributes","inventory","equipment","skills","mastery","quests","friends","blocked_ids","owned_skins","server_roles","stats","titles","dailies","dungeon_lockouts","redeemed_codes","wardstones","joined_guild_ids"]:
		columns.append(field+"_json TEXT NOT NULL")
	var statements: Array[String]=[
		"CREATE SCHEMA realm;",
		"CREATE SEQUENCE realm.account_ids START 2;",
		"CREATE SEQUENCE realm.player_ids;",
		"CREATE TABLE realm.accounts(account_name TEXT PRIMARY KEY,master_account_id BIGINT NOT NULL UNIQUE DEFAULT nextval('realm.account_ids') CHECK(master_account_id>1),password_hash TEXT NOT NULL,last_world_name TEXT NOT NULL DEFAULT '',last_character_id BIGINT NOT NULL DEFAULT 0);",
		"CREATE TABLE realm.players("+", ".join(columns)+");",
		"CREATE INDEX realm_players_account ON realm.players(account_name);",
		"CREATE TABLE realm.guilds(guild_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,guild_name TEXT NOT NULL UNIQUE,leader_id BIGINT NOT NULL,data_json TEXT NOT NULL);",
		"CREATE TABLE realm.guild_members(guild_id BIGINT NOT NULL REFERENCES realm.guilds(guild_id) ON DELETE CASCADE,player_id BIGINT NOT NULL,rank BIGINT NOT NULL,PRIMARY KEY(guild_id,player_id));",
		"CREATE TABLE realm.guild_log(log_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,guild_id BIGINT NOT NULL REFERENCES realm.guilds(guild_id) ON DELETE CASCADE,time_ms BIGINT NOT NULL,event TEXT NOT NULL,actor_name TEXT NOT NULL,target_name TEXT NOT NULL,data_json TEXT NOT NULL);",
		"CREATE INDEX realm_guild_log_time ON realm.guild_log(guild_id,log_id DESC);",
		"CREATE TABLE realm.conversations(conversation_id TEXT PRIMARY KEY,type TEXT NOT NULL,meta_json TEXT NOT NULL,next_msg_id BIGINT NOT NULL DEFAULT 0);",
		"CREATE TABLE realm.messages(conversation_id TEXT NOT NULL REFERENCES realm.conversations(conversation_id),msg_id BIGINT NOT NULL,time_ms BIGINT NOT NULL,sender_id BIGINT NOT NULL,sender_name TEXT NOT NULL,text TEXT NOT NULL,PRIMARY KEY(conversation_id,msg_id));",
		"CREATE INDEX realm_messages_sender ON realm.messages(sender_id,time_ms);",
		"CREATE TABLE realm.mail(mail_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,recipient_id BIGINT NOT NULL,sender_name TEXT NOT NULL,subject TEXT NOT NULL,body TEXT NOT NULL,attachments_json TEXT NOT NULL,created_at_ms BIGINT NOT NULL);",
		"CREATE INDEX realm_mail_recipient ON realm.mail(recipient_id,created_at_ms DESC);",
		"CREATE TABLE realm.mail_state(player_id BIGINT NOT NULL,mail_id BIGINT NOT NULL REFERENCES realm.mail(mail_id) ON DELETE CASCADE,read_at_ms BIGINT,claimed_at_ms BIGINT,deleted_at_ms BIGINT,PRIMARY KEY(player_id,mail_id));",
		"INSERT INTO economy.schema_versions(feature,version) VALUES('realm_state',1);"
	]
	for sql: String in statements:
		if not db.execute(sql).ok:
			db.rollback();return false
	if not db.execute("INSERT INTO economy.meta(key,value) VALUES('world_profile_id',:id) ON CONFLICT DO NOTHING;",{"id":Crypto.new().generate_random_bytes(16).hex_encode()}).ok:
		db.rollback();return false
	if db.commit(): return preload("res://source/server/world/database/character_stats_schema.gd").postgres(db)
	db.close();return false

## Small, explicit connection setup for profiles or Master credentials, never combat.
## Credentials remain in the environment. No runtime DDL or SQLite fallback.
static func connect_store(settings: Dictionary) -> Object:
	if not ClassDB.class_exists("GodotSociDatabase"): return null
	var db: Object=ClassDB.instantiate("GodotSociDatabase")
	if not db.open("postgresql",OS.get_environment(str(settings.connection_env))+" connect_timeout=3"): return null
	var result: Dictionary=db.query("SELECT m.value FROM economy.meta m JOIN economy.schema_versions v ON v.feature='realm_state' AND v.version=1 JOIN economy.schema_versions s ON s.feature='character_stats' AND s.version=1 WHERE m.key='economy_authority_id' AND m.value=:authority;",{"authority":settings.authority_id})
	if not result.ok or result.rows.size()!=1 or not db.execute("SET search_path TO realm,pg_catalog;").ok or not db.execute("SET statement_timeout='3s';").ok or not db.execute("SET lock_timeout='1s';").ok:
		db.close();return null
	return db
