extends RefCounted
## Seller lifecycle only: explicit Shop escrow, no claims/revenue placeholders.
const StorageSchema = preload("res://source/server/world/database/postgres/storage_schema_postgres.gd")

static func ensure_schema(db: Object) -> bool:
	if not StorageSchema.ensure_schema(db) or not db.begin(): return false
	var result: Dictionary=db.query("SELECT version FROM economy.schema_versions WHERE feature='shop_seller';")
	if not result.ok or (not result.rows.is_empty() and int(result.rows[0].version)!=1):
		db.rollback()
		return false
	if result.rows.is_empty():
		for sql: String in [
			"CREATE TABLE economy.account_shops(shop_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,account_id BIGINT NOT NULL UNIQUE REFERENCES economy.accounts(account_id),display_name TEXT NOT NULL DEFAULT 'My Shop' CHECK(length(display_name) BETWEEN 1 AND 40),status TEXT NOT NULL DEFAULT 'active' CHECK(status IN ('active','paused')),revision BIGINT NOT NULL DEFAULT 0 CHECK(revision>=0),UNIQUE(shop_id,account_id));",
			"ALTER TABLE economy.item_custody ADD COLUMN escrow_account_id BIGINT REFERENCES economy.accounts(account_id), ADD COLUMN shop_id BIGINT, ADD COLUMN offer_id TEXT;",
			"ALTER TABLE economy.item_custody ADD CONSTRAINT escrow_provenance_account FOREIGN KEY(owner_id,escrow_account_id) REFERENCES economy.characters(character_id,account_id) DEFERRABLE INITIALLY DEFERRED, ADD CONSTRAINT escrow_shop_account FOREIGN KEY(shop_id,escrow_account_id) REFERENCES economy.account_shops(shop_id,account_id) DEFERRABLE INITIALLY DEFERRED, ADD CONSTRAINT custody_offer_tuple UNIQUE(uid,offer_id,shop_id,escrow_account_id,position), ADD CONSTRAINT custody_shop_identity UNIQUE(uid,shop_id);",
			"ALTER TABLE economy.item_custody DROP CONSTRAINT item_custody_location_check, DROP CONSTRAINT item_custody_check;",
			"ALTER TABLE economy.item_custody ADD CONSTRAINT item_custody_location_check CHECK(location IN ('bag','equipment','account_storage','shop_escrow')), ADD CONSTRAINT item_custody_check CHECK((location='bag' AND position BETWEEN 0 AND 179 AND equipment_slot='' AND storage_account_id IS NULL AND escrow_account_id IS NULL AND shop_id IS NULL AND offer_id IS NULL) OR (location='equipment' AND position=-1 AND equipment_slot<>'' AND storage_account_id IS NULL AND escrow_account_id IS NULL AND shop_id IS NULL AND offer_id IS NULL) OR (location='account_storage' AND position BETWEEN 0 AND 269 AND equipment_slot='' AND storage_account_id IS NOT NULL AND escrow_account_id IS NULL AND shop_id IS NULL AND offer_id IS NULL) OR (location='shop_escrow' AND position BETWEEN 0 AND 39 AND equipment_slot='' AND storage_account_id IS NULL AND escrow_account_id IS NOT NULL AND shop_id IS NOT NULL AND offer_id IS NOT NULL));",
			"CREATE TABLE economy.shop_offers(offer_id TEXT PRIMARY KEY CHECK(offer_id ~ '^[0-9a-f]{32}$'),shop_id BIGINT NOT NULL,account_id BIGINT NOT NULL,item_uid TEXT NOT NULL UNIQUE,position BIGINT NOT NULL CHECK(position BETWEEN 0 AND 39),price_yang BIGINT NOT NULL CHECK(price_yang BETWEEN 1 AND 9000000000000000),offer_only BIGINT NOT NULL DEFAULT 0 CHECK(offer_only IN (0,1)),revision BIGINT NOT NULL DEFAULT 0 CHECK(revision>=0),FOREIGN KEY(shop_id,account_id) REFERENCES economy.account_shops(shop_id,account_id),FOREIGN KEY(item_uid,offer_id,shop_id,account_id,position) REFERENCES economy.item_custody(uid,offer_id,shop_id,escrow_account_id,position) DEFERRABLE INITIALLY DEFERRED,UNIQUE(offer_id,item_uid,shop_id,account_id,position));",
			"ALTER TABLE economy.item_custody ADD CONSTRAINT custody_has_offer FOREIGN KEY(offer_id,uid,shop_id,escrow_account_id,position) REFERENCES economy.shop_offers(offer_id,item_uid,shop_id,account_id,position) DEFERRABLE INITIALLY DEFERRED;",
			"CREATE UNIQUE INDEX custody_shop_position ON economy.item_custody(shop_id,position) WHERE location='shop_escrow';",
			"CREATE UNIQUE INDEX custody_offer_identity ON economy.item_custody(offer_id) WHERE offer_id IS NOT NULL;",
			"CREATE TABLE economy.shop_cells(shop_id BIGINT NOT NULL,position BIGINT NOT NULL CHECK(position BETWEEN 0 AND 39),item_uid TEXT NOT NULL,PRIMARY KEY(shop_id,position),FOREIGN KEY(item_uid,shop_id) REFERENCES economy.item_custody(uid,shop_id) DEFERRABLE INITIALLY DEFERRED);",
			"CREATE INDEX shop_cells_item ON economy.shop_cells(item_uid);",
			"INSERT INTO economy.schema_versions(feature,version) VALUES('shop_seller',1);"
		]:
			var written: Dictionary=db.execute(sql)
			if not written.ok:
				push_error("Shop seller schema bootstrap failed: "+str(written))
				db.rollback()
				return false
	if db.commit(): return true
	db.close()
	return false
